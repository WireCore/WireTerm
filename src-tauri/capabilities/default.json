{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$TEMP/wireterm-edit/*/*"
        }
      ]
    }
  ]
}
